# Copy to .env to override the defaults. Never commit .env.

# Needed for coaching and for reading board pictures.
ANTHROPIC_API_KEY=
# The Claude model the coach uses.
COACH_MODEL=claude-sonnet-5-5
# How hard the coach thinks: low, medium or high. Higher costs more output tokens.
COACH_EFFORT=medium
# The local model that embeds strategy notes for retrieval. It runs on your machine and costs
# nothing. Changing it re-embeds every note on the next summary.
EMBEDDING_MODEL=minishlab/potion-base-8M

# Local development password only. The database port is bound to localhost.
POSTGRES_PASSWORD=rackwise

# Host ports
POSTGRES_PORT=5433
ENGINE_PORT=8080
COACH_PORT=8000
WEB_PORT=5173
# Set to 0.0.0.0 to open the app from a phone on the same Wi-Fi. There is no login, so anyone
# on that network could use it and your API key. Use a trusted network only.
WEB_HOST=127.0.0.1

# For running the coach outside Docker. Compose sets its own value for the
# coach container, using the "db" hostname.
DATABASE_URL=postgresql://rackwise:rackwise@localhost:5433/rackwise
